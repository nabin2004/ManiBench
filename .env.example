# ManiBench Evaluation — Environment Variables
# ===============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── OpenRouter API Key / token (required for --provider openrouter) ──
# Get your key at: https://openrouter.ai/keys
# You can also pass it on the CLI: --api-key sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional OpenRouter base URL override
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Inference.net API Key (required for --provider inference) ──
# Get your key at: https://inference.net
INFERENCE_API_KEY=your-inference-net-key-here

# ── OpenAI-compatible / vLLM (for --provider openai) ──
# Base URL of your server's OpenAI-compatible API (include /v1)
# OPENAI_BASE_URL=http://localhost:8000/v1
# Optional; leave empty for unauthenticated local vLLM
# OPENAI_API_KEY=

# ── Optional: Override defaults ──
# INFERENCE_BASE_URL=https://api.inference.net/v1
# REQUEST_TIMEOUT=120
# MAX_RETRIES=3
